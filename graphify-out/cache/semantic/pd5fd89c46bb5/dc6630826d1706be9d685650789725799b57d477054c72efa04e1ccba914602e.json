{"nodes": [{"id": "10_series_temporales_01_teoria_presentaciones_02_procesamiento_slides_doc", "label": "02_procesamiento_slides.md", "file_type": "document", "source_file": "10-series-temporales/01-teoria/presentaciones/02_procesamiento_slides.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "10_series_temporales_01_teoria_presentaciones_02_procesamiento_slides_procesamiento_datos", "label": "Obtenci\u00f3n y procesamiento de datos", "file_type": "concept", "source_file": "10-series-temporales/01-teoria/presentaciones/02_procesamiento_slides.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El 80% del \u00e9xito en forecasting depende de una correcta preparaci\u00f3n de los datos. Antes de programar hay que entender qu\u00e9 representa cada fila, el eje temporal, la frecuencia esperada y si hay series mezcladas."}, {"id": "10_series_temporales_01_teoria_presentaciones_02_procesamiento_slides_formato_largo", "label": "Formato largo", "file_type": "concept", "source_file": "10-series-temporales/01-teoria/presentaciones/02_procesamiento_slides.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "10_series_temporales_01_teoria_presentaciones_02_procesamiento_slides_fechas_pandas", "label": "Fechas como \u00edndice en Pandas", "file_type": "concept", "source_file": "10-series-temporales/01-teoria/presentaciones/02_procesamiento_slides.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "10_series_temporales_01_teoria_presentaciones_02_procesamiento_slides_fe_calendario", "label": "Extraer el latido del calendario", "file_type": "concept", "source_file": "10-series-temporales/01-teoria/presentaciones/02_procesamiento_slides.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "10_series_temporales_01_teoria_presentaciones_02_procesamiento_slides_huecos_implicitos", "label": "Huecos impl\u00edcitos y asfreq", "file_type": "concept", "source_file": "10-series-temporales/01-teoria/presentaciones/02_procesamiento_slides.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La fila que no existe (hueco impl\u00edcito) destruye el modelo si se resta creyendo que pas\u00f3 un d\u00eda; hay que forzar la aparici\u00f3n del hueco con asfreq() y tratarlo como NaN."}, {"id": "10_series_temporales_01_teoria_presentaciones_02_procesamiento_slides_imputacion", "label": "Imputaci\u00f3n de nulos", "file_type": "concept", "source_file": "10-series-temporales/01-teoria/presentaciones/02_procesamiento_slides.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Imputar nulos con la media global es un crimen en series temporales. ffill arrastra el \u00faltimo valor conocido y evita espiar el futuro; la interpolaci\u00f3n requiere conocer el futuro para dibujarse."}, {"id": "10_series_temporales_01_teoria_presentaciones_02_procesamiento_slides_perfiles_estacionales", "label": "Perfiles estacionales", "file_type": "concept", "source_file": "10-series-temporales/01-teoria/presentaciones/02_procesamiento_slides.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Si falta un domingo a las 20:00 se imputa con la media hist\u00f3rica de todos los domingos a las 20:00, preservando el pulso vital de la serie."}, {"id": "10_series_temporales_01_teoria_presentaciones_02_procesamiento_slides_merge_temporal", "label": "Merge temporal con contexto est\u00e1tico", "file_type": "concept", "source_file": "10-series-temporales/01-teoria/presentaciones/02_procesamiento_slides.md", "source_location": null, "source_url": null, "captured_at": nul