{"nodes": [{"id": "10_series_temporales_01_teoria_presentaciones_09_transformers_slides_doc", "label": "09_transformers_slides.md", "file_type": "document", "source_file": "10-series-temporales/01-teoria/presentaciones/09_transformers_slides.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "10_series_temporales_01_teoria_presentaciones_09_transformers_slides_transformers", "label": "Transformers en series temporales", "file_type": "concept", "source_file": "10-series-temporales/01-teoria/presentaciones/09_transformers_slides.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "En tiempo, un punto (1.85 kWh) no significa nada por s\u00ed solo; la atenci\u00f3n entre puntos sin sem\u00e1ntica individual es ruido puro y el coste es O(L^2)."}, {"id": "10_series_temporales_01_teoria_presentaciones_09_transformers_slides_attention_is_all_you_need", "label": "Attention is All You Need (2017)", "file_type": "paper", "source_file": "10-series-temporales/01-teoria/presentaciones/09_transformers_slides.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Google", "contributor": null}, {"id": "10_series_temporales_01_teoria_presentaciones_09_transformers_slides_transformers_efectivos_paper", "label": "Are Transformers Effective for Time Series Forecasting? (2023)", "file_type": "paper", "source_file": "10-series-temporales/01-teoria/presentaciones/09_transformers_slides.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "10_series_temporales_01_teoria_presentaciones_09_transformers_slides_tokenismo", "label": "Tokenismo punto a punto", "file_type": "concept", "source_file": "10-series-temporales/01-teoria/presentaciones/09_transformers_slides.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"