{"nodes": [{"id": "05_cloud_mlops_01_teoria_01_feature_store", "label": "Feature Store (teor\u00eda)", "file_type": "document", "source_file": "05-cloud-mlops/01-teoria/01-feature-store.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "05_cloud_mlops_01_teoria_01_feature_store_dual_architecture", "label": "Arquitectura dual offline/online", "file_type": "rationale", "source_file": "05-cloud-mlops/01-teoria/01-feature-store.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La variable debe definirse una sola vez y reutilizarse en entrenamiento (almacen offline) e inferencia (almacen online); si la logica se reimplementa por separado, aparece la inconsistencia entre entrenamiento e inferencia."}, {"id": "05_cloud_mlops_01_teoria_01_feature_store_train_inference_skew", "label": "Inconsistencia entrenamiento-inferencia", "file_type": "rationale", "source_file": "05-cloud-mlops/01-teoria/01-feature-store.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Si una variable se calcula de una forma en entrenamiento y de otra en produccion, el modelo se entrena con unos valores y recibe otros distintos, degradando el rendimiento o provocando errores dificiles de detectar."}, {"id": "05_cloud_mlops_01_teoria_01_feature_store_feast", "label": "Feast", "file_type": "concept", "source_file": "05-cloud-mlops/01-teoria/01-feature-store.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "05_cloud_mlops_01_teoria_01_feature_store_feathr", "label": "Feathr", "file_type": "concept", "source_file": "05-cloud-mlops/01-teoria/01-feature-store.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "05_cloud_mlops_01_teoria_01_feature_store_tecton", "label": "Te