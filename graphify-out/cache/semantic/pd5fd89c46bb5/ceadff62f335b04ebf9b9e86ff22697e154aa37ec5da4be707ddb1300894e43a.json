{"nodes": [{"id": "10_series_temporales_01_teoria_presentaciones_06_fe_slides_doc", "label": "06_fe_slides.md", "file_type": "document", "source_file": "10-series-temporales/01-teoria/presentaciones/06_fe_slides.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "10_series_temporales_01_teoria_presentaciones_06_fe_slides_feature_engineering", "label": "Feature Engineering", "file_type": "concept", "source_file": "10-series-temporales/01-teoria/presentaciones/06_fe_slides.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El ML es como un cocinero: por muy bueno que sea el chef, si los ingredientes son mediocres el plato ser\u00e1 mediocre. El horizonte dicta qu\u00e9 lags son legales."}, {"id": "10_series_temporales_01_teoria_presentaciones_06_fe_slides_horizonte", "label": "El horizonte dicta las reglas", "file_type": "concept", "source_file": "10-series-temporales/01-teoria/presentaciones/06_fe_slides.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Con horizonte de 24 horas no hay acceso al Lag_1: el valor de las pr\u00f3ximas 23 horas es futuro desconocido. No adaptar los lags al horizonte es la forma m\u00e1s com\u00fan de fracasar en producci\u00f3n."}, {"id": "10_series_temporales_01_teoria_presentaciones_06_fe_slides_ventanas_moviles", "label": "Ventanas m\u00f3viles", "file_type": "concept", "source_file": "10-series-temporales/01-teoria/presentaciones/06_fe_slides.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "10_series_temporales_01_teoria_presentaciones_06_fe_slides_ewma", "label": "EWMA (media m\u00f3vil exponencial)", "file_type": "concept", "source_file": "10-series-temporales/01-teoria/presentaciones/06_fe_slides.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "10_series_temporales_01_teoria_presentaciones_06_fe_slides_trigonometria_temporal", "label": "Trigonometr\u00eda temporal (seno/coseno)", "file_type": "concept", "source_file": "10-series-temporales/01-teoria/presentaciones/06_fe_slides.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Si se da la hora de 0 a 23, el modelo piensa que hay distancia enorme entre 23:59 y 00:01; proyectar el tiempo en un c\u00edrculo con seno y coseno elimina el salto de medianoche."}, {"id": "10_series_temporales_01_teoria_presentaciones_06_fe_slides_fourier", "label": "Sinfon\u00edas de Fourier", "file_type": "concept", "source_file": "10-series-temporales/01-teoria/presentaciones/06_fe_slides.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "10_series_temporales_01_teoria_presentaciones_06_fe_slides_multi_horizonte", "label": "Forecast multi-horizonte", "file_type": "concept", "source_file": "10-series-temporales/01-teoria/presentaciones/06_fe_slides.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "10_series_temporales_01_teoria_presentaciones_06_fe_slides_nb_06_fe", "label": "06_feature_engineering_series_temporales.ipynb", "file_type": "document", "source_file": "10-series-temporales/01-teoria/presentaciones/06_fe_slides.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "10_series_temporales_01_teoria_presentaciones_06_fe_slides_doc", "target": "10_series_temporales_01_teoria_presentaciones_06_fe_slides_feature_engineering", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "10-series-temporales/01-teoria/presentaciones/06_fe_slides.md", "source_location": null, "weight": 1.0}, {"source": "10_series_tempo